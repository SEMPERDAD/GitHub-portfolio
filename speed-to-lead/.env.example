# Server
PORT=3000

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Email (SMTP — works with Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM_NAME=Your Business Name
EMAIL_FROM_ADDRESS=your_email@gmail.com

# Business Info (used in AI-generated messages)
BUSINESS_NAME=Your Business Name
BUSINESS_PHONE=+1XXXXXXXXXX
BUSINESS_CALENDAR_URL=https://calendly.com/yourbusiness
BUSINESS_WEBSITE=https://yourbusiness.com
