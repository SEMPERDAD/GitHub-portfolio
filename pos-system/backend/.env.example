# Server
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=8h

# Database (SQLite by default — swap DB_TYPE to 'postgres' for PostgreSQL)
DB_TYPE=sqlite
DB_PATH=./pos_data.db

# PostgreSQL (if DB_TYPE=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pos_system
# DB_USER=pos_user
# DB_PASSWORD=your_password

# Tax Configuration
DEFAULT_TAX_RATE=0.08
TAX_INCLUSIVE=false

# Currency
CURRENCY_CODE=USD
CURRENCY_SYMBOL=$

# Receipt
STORE_NAME=My Store
STORE_ADDRESS=123 Main St, City, ST 00000
STORE_PHONE=(555) 000-0000
RECEIPT_FOOTER=Thank you for your business!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
